# Postgres connection (Supabase: Project Settings → Database → connection string, session pooler)
DATABASE_URL=
# HMAC key for app session cookies (long random string)
SESSION_SECRET=
# Supabase project (Google sign-in via Supabase Auth, BR-40)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public base URL, e.g. https://saapidalaam.onrender.com
APP_URL=
# "off" in production to skip the demo accounts seed
DEMO_SEED=
# Supabase CLI only (config push): Google OAuth client from Google Cloud Console
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
